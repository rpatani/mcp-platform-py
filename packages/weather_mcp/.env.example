# weather-mcp environment (copy to .env; all optional — free tools need no secrets)

# Transport: stdio (default) or http
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_PATH=/mcp

# Key store (enables tiers); omit to run fully anonymous/free
MCP_KEYS_FILE=packages/weather_mcp/keys.example.json

# Metrics (auto-on for http). Backend: prometheus (default) or otel
MCP_METRICS_BACKEND=prometheus
MCP_METRICS_PORT=9464

LOG_LEVEL=info

# Resilience knobs (defaults shown)
MCP_UPSTREAM_TIMEOUT_S=4.0
MCP_UPSTREAM_RETRIES=2
MCP_BREAKER_THRESHOLD=5
MCP_BREAKER_COOLDOWN_S=30

# Required ONLY for the premium tool (get_weather_premium)
# OPENWEATHERMAP_API_KEY=your-key-here
